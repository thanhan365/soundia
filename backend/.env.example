# ═══════════════════════════════════════════════════════════════════
# Soundia Backend - Biến môi trường (MẪU)
# Sao chép file này thành .env và điền giá trị phù hợp
# KHÔNG COMMIT FILE .env LÊN GIT!
# ═══════════════════════════════════════════════════════════════════

# Database
DB_CONNECTION_STRING=Server=YOUR_SERVER;Database=SoundiaDb;User ID=sa;Password=YOUR_PASSWORD;MultipleActiveResultSets=true;TrustServerCertificate=True;Encrypt=False

# JWT
JWT_KEY=YOUR_JWT_SECRET_KEY_MUST_BE_AT_LEAST_64_CHARACTERS_LONG
JWT_ISSUER=SoundiaApp
JWT_AUDIENCE=SoundiaUsers

# NhacCuaTui API
NCT_API_URL=https://beta.nhaccuatui.com/api
NCT_API_KEY=YOUR_NCT_API_KEY
NCT_SECRET_KEY=YOUR_NCT_SECRET_KEY
